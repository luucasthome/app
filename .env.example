# Copie para .env (ou defina como variáveis de ambiente no serviço de hospedagem).
# Nenhum destes valores deve ser versionado.

PORT=3000
NODE_ENV=development

# Endereço público do app. Usado nos links de recuperação de senha.
BASE_URL=http://localhost:3000

# Caminho do arquivo SQLite. Em produção, aponte para um disco persistente (ex.: /data/follow.db).
DATABASE_PATH=./data/follow.db

# Envio de e-mail (recuperação de senha). Formato: smtp://usuario:senha@servidor:587
# Sem SMTP_URL, o link de recuperação é apenas escrito no log do servidor (útil em desenvolvimento).
SMTP_URL=
MAIL_FROM=Follow <nao-responder@seudominio.com>

# Defina como 1 quando houver proxy reverso (Render, Fly, Railway, Nginx...) à frente do app.
TRUST_PROXY=0
